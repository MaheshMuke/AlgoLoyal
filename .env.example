# SmartAPI credentials
ANGEL_API_KEY=your_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_password
ANGEL_TOTP=your_totp

# SmartAPI required client headers
ANGEL_CLIENT_PUBLIC_IP=your_public_ip
ANGEL_CLIENT_LOCAL_IP=127.0.0.1
ANGEL_CLIENT_MAC=your_mac_address
ANGEL_SOURCE_ID=WEB
ANGEL_USER_TYPE=USER

# Market quote request settings
ANGEL_EXCHANGE=NSE
ANGEL_EXCHANGE_TOKENS=3045
